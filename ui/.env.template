# ============================================================================
# Member Portal UI - Environment Variables Template
# ============================================================================
#
# This file serves as a template for creating your .env file.
# Copy this file to .env and fill in the actual values.
#
# IMPORTANT: Never commit the .env file to version control!
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# Enable/disable development mode (true/false)
# Development mode enables additional logging and debugging features
ENV_DEV_MODE=true

# Port the UI listens on
ENV_PORT=8000

# Base URL for the UI application
ENV_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# OAuth/OIDC Configuration (Keycloak)
# ----------------------------------------------------------------------------

# OAuth authorization endpoint
ENV_AUTHORIZE_URL=https://login.dallasmakerspace.org/realms/DMS/protocol/openid-connect/auth

# OAuth token endpoint
ENV_ACCESS_TOKEN_URL=https://login.dallasmakerspace.org/realms/DMS/protocol/openid-connect/token

# OAuth client ID
ENV_CLIENT_ID=member-profile

# OAuth client secret
ENV_CLIENT_SECRET=your-client-secret-here

# SSO profile URL
ENV_SSO_PROFILE_URL=https://login.dallasmakerspace.org/realms/DMS/account/

# OAuth user info endpoint
ENV_USER_INFO_URL=https://login.dallasmakerspace.org/realms/DMS/protocol/openid-connect/userinfo

# ----------------------------------------------------------------------------
# Discourse SSO Integration
# ----------------------------------------------------------------------------

# Discourse SSO shared secret
ENV_DISCOURSE_SSO_SECRET=your-discourse-sso-secret-here

# Discourse SSO redirect URL
ENV_DISCOURSE_REDIRECT_URL=http://localhost:8000/discourse-callback

# ----------------------------------------------------------------------------
# Discord OAuth2 Integration
# ----------------------------------------------------------------------------

# Discord OAuth2 client ID (from Discord Developer Portal)
ENV_DISCORD_CLIENT_ID=your-discord-client-id-here

# Discord OAuth2 client secret (from Discord Developer Portal)
ENV_DISCORD_CLIENT_SECRET=your-discord-client-secret-here

# Discord OAuth2 redirect URL
ENV_DISCORD_REDIRECT_URL=http://localhost:8000/discord-callback

# Discord bot token (optional - for role sync feature)
ENV_DISCORD_BOT_TOKEN=

# Discord guild/server ID (optional - for role sync feature)
ENV_DISCORD_GUILD_ID=

# ----------------------------------------------------------------------------
# LinkedIn OAuth2 Integration
# ----------------------------------------------------------------------------

# LinkedIn OAuth2 client ID (from LinkedIn Developer Portal)
ENV_LINKEDIN_CLIENT_ID=your-linkedin-client-id-here

# LinkedIn OAuth2 client secret (from LinkedIn Developer Portal)
ENV_LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret-here

# LinkedIn OAuth2 redirect URL
ENV_LINKEDIN_REDIRECT_URL=http://localhost:8000/linkedin-callback

# ----------------------------------------------------------------------------
# Member Profile Service Backend
# ----------------------------------------------------------------------------

# URL of the member profile service backend API
ENV_SERVICE_URL=http://localhost:8081

# API key for authenticating with the backend service
# This should match one of the API_CLIENT_N_KEY values in the service .env
ENV_SERVICE_API_KEY=your-service-api-key-here

# API client identifier for the backend service
# This should match one of the API_CLIENT_N_NAME values in the service .env
ENV_SERVICE_API_CLIENT_ID=member-profile-ui

# ----------------------------------------------------------------------------
# Chrono Ring Integration
# ----------------------------------------------------------------------------

ENV_CHRONO_RING_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# External Webhook Proxies
# ----------------------------------------------------------------------------
#
# The backend service is only reachable inside the network, so truly external
# systems (SmartWaiver, SparkPost) call these public UI routes instead, each
# guarded by a `?token=` query param, which then proxy the raw payload through
# to the service's own /webhook/* endpoint. Internal-only callers (e.g. the
# calendar app, group-audit) hit the service directly and don't need this.

# Shared secret for SmartWaiver's webhook (https://<host>/webhook/smartwaiver?token=...)
ENV_SMARTWAIVER_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# Shared secret for SparkPost's event webhook (https://<host>/webhook/sparkpost?token=...)
ENV_SPARKPOST_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# Secret for Discourse's post webhook (https://<host>/webhook/discourse). Unlike the two above it
# is not a query token: enter the same value as the webhook's "Secret" in Discourse, which signs
# each delivery (X-Discourse-Event-Signature) and this route verifies it.
ENV_DISCOURSE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ----------------------------------------------------------------------------
# PostHog Analytics (optional)
# ----------------------------------------------------------------------------

# PostHog project API key (leave empty to disable)
ENV_POSTHOG_API_KEY=

# PostHog host (default: https://us.i.posthog.com)
ENV_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# Session Security
# ----------------------------------------------------------------------------

# AES-128 encryption key for cookie sessions (generate with: openssl rand -hex 16)
# Optional in development - application.conf provides a dummy default.
# REQUIRED in production - must be set to a real random value.
SESSION_ENCRYPT_KEY=your-32-hex-char-encrypt-key-here

# HMAC-SHA256 signing key for cookie sessions (generate with: openssl rand -hex 32)
# Optional in development - application.conf provides a dummy default.
# REQUIRED in production - must be set to a real random value.
SESSION_SIGN_KEY=your-64-hex-char-sign-key-here

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log level (debug, info, warn, error)
ENV_LOG_LEVEL=debug

# Elasticsearch logging (optional)
ENV_ELASTIC_HOST=localhost:9200
ENV_ELASTIC_API_KEY=your-elastic-api-key-here
# Set to false to keep Elastic logging off locally even with ENV_DEV_MODE=false (real-backends
# testing) - defaults to true, i.e. no change from prior behavior.
ENV_ELASTIC_LOGGING_ENABLED=true
