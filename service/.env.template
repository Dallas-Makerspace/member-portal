# ============================================================================
# Member Portal Service - Environment Variables Template
# ============================================================================
#
# This file serves as a template for creating your .env file.
# Copy this file to .env and fill in the actual values.
#
# IMPORTANT: Never commit the .env file to version control!
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# Enable/disable development mode (true/false)
# Development mode enables additional logging and debugging features
#
# DEV_MODE and USE_MOCK_SERVICES both being false is what disables ALL mocks at once
# (AD/LDAP, WinRM, Guacamole, Discourse, the master DB, SmartWaiver, notifications, AskAI) -
# there's no per-integration toggle. Either one being true keeps mocks on.
DEV_MODE=false

# Use mock services for external integrations (true/false)
# Set to true for local development without external dependencies
USE_MOCK_SERVICES=false

# Ktor request/response timeouts in seconds (optional - defaults shown)
KTOR_REQUEST_READ_TIMEOUT=60
KTOR_RESPONSE_WRITE_TIMEOUT=60
KTOR_REQUEST_TIMEOUT=120

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# Primary database connection (MariaDB)
DB_URL=jdbc:mariadb://localhost:3306/member_profile
DB_USER=member_profile_user
DB_PASSWORD=your-db-password-here

# Master database connection (WHMCS/MakerManager)
DB_MASTER_URL=jdbc:mariadb://localhost:3306/master_db
DB_MASTER_USER=master_user
DB_MASTER_PASSWORD=your-master-db-password-here

# ----------------------------------------------------------------------------
# API Client Authentication & Authorization (RBAC)
# ----------------------------------------------------------------------------

# Number of API clients configured
# Update this count when adding/removing clients
API_CLIENT_COUNT=1

# Each client requires NAME, KEY, and ROLE (singular).
# ROLE must be one of the role names listed below.
#
# Example:
#   API_CLIENT_0_NAME=member-profile-ui
#   API_CLIENT_0_KEY=your-api-key-here
#   API_CLIENT_0_ROLE=UI_SUPERUSER

# Client 0: member-profile-ui
API_CLIENT_0_NAME=member-profile-ui
API_CLIENT_0_KEY=your-ui-api-key-here
API_CLIENT_0_ROLE=UI_SUPERUSER

# Available roles and their permissions:
#
# Organizational roles (mapped from Keycloak groups on the UI side):
#   UI_SUPERUSER  = all permissions (use for the member-profile-ui client)
#   INFRA         = all permissions
#   OFFICER       = MANAGE_GROUPS, MANAGE_BADGES
#   BOARD         = MANAGE_CONFIG
#   MEMBER        = USE_ASKAI
#
# Service-account roles (use for non-UI API clients):
#   MEMBER_READER = MANAGE_MEMBERS  (member lookup, activity logging)
#   BADGE_READER  = MANAGE_BADGES   (badge number lookup)
#   CRON_EXECUTOR = EXECUTE_CRON    (trigger scheduled jobs)
#
# Available permissions:
#   MANAGE_MEMBERS    = member data, activity log, calendar, featured projects
#   MANAGE_GROUPS     = group read/write
#   MANAGE_BADGES     = badge lookup and fix
#   MANAGE_SHORTLINKS = short links read/write
#   MANAGE_CONFIG     = runtime config read/write
#   EXECUTE_CRON      = trigger cron jobs
#   USE_ASKAI         = Ask DMS AI

# ----------------------------------------------------------------------------
# LDAP / Active Directory Configuration
# ----------------------------------------------------------------------------

# LDAP server connection
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_USER=cn=admin,dc=example,dc=com
LDAP_PASSWORD=your-ldap-password-here

# ----------------------------------------------------------------------------
# External Integrations
# ----------------------------------------------------------------------------

# Discourse forum integration
DISCOURSE_API_KEY=your-discourse-api-key-here

# Guacamole (remote access sessions)
GUACAMOLE_BASE_URL=http://localhost:8086/guacamole
GUACAMOLE_ADMIN_USERNAME=admin
GUACAMOLE_ADMIN_PASSWORD=your-guacamole-admin-password-here

# WinRM - used to detect direct (non-Guacamole) RDP sessions on target machines. One
# shared least-privilege service account (member of "Remote Management Users" locally
# on each target, not local Administrators) is used against every machine.
# WINRM_USERNAME should be DOMAIN\user - a bare username resolves against the target's
# local accounts instead of the domain account.
WINRM_PORT=5985
WINRM_USERNAME=DOMAIN\your-service-account
WINRM_PASSWORD=your-winrm-password-here
# All optional - defaults shown
WINRM_CONNECT_TIMEOUT_MS=500
WINRM_OPERATION_TIMEOUT_MS=1200
WINRM_CALL_TIMEOUT_MS=1500
WINRM_EXECUTOR_POOL_SIZE=8

# SmartWaiver
SMARTWAIVER_API_KEY=your-smartwaiver-api-key-here

# ----------------------------------------------------------------------------
# Notifications Configuration
# ----------------------------------------------------------------------------

# SparkPost REST API key (email delivery). Create in the SparkPost dashboard
# under Account -> API Keys with at least Transmissions read/write.
SPARKPOST_API_KEY=your-sparkpost-api-key-here
# Sender address/name (from-domain must be verified in SparkPost)
SPARKPOST_FROM_EMAIL=no-reply@dallasmakerspace.org
SPARKPOST_FROM_NAME=DMS Notifications

# Worker/digest cadence tuning - all optional, defaults shown
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_POLL_INTERVAL_MS=5000
NOTIFICATIONS_WORKER_BATCH_SIZE=50
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_RETRY_BACKOFF_SECONDS=60
NOTIFICATIONS_RETRY_MAX_BACKOFF_SECONDS=21600
NOTIFICATIONS_DIGEST_ENABLED=true
NOTIFICATIONS_DIGEST_POLL_INTERVAL_MS=60000
NOTIFICATIONS_DIGEST_BATCH_SIZE=200
NOTIFICATIONS_DIGEST_MAX_ATTEMPTS=5
NOTIFICATIONS_DIGEST_RETRY_BACKOFF_SECONDS=300
NOTIFICATIONS_DIGEST_RETRY_MAX_BACKOFF_SECONDS=21600

# ----------------------------------------------------------------------------
# Ask DMS AI Configuration
# ----------------------------------------------------------------------------

# LLM provider: "bedrock" (default) or "openrouter"
LLM_PROVIDER=bedrock

# AWS Bedrock credentials (required when LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
# BEDROCK_MODEL defaults to us.anthropic.claude-haiku-4-5-20251001-v1:0 — override only to change model

# OpenRouter API (only required when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_BASE_URL defaults to https://openrouter.ai/api/v1 — override only to change endpoint
# OPENROUTER_MODEL defaults to google/gemini-3.1-flash-lite-preview — override only to change model

# Monthly LLM spend cap in USD (default: 12.0, set to 0 to disable)
ASKAI_MONTHLY_BUDGET_USD=12.0
# ASKAI_CACHE_TTL_DAYS defaults to 30 — override only to change cache lifetime
# ASKAI_MAX_SEARCH_RESULTS defaults to 10 — override only to change search result count

# Confluence wiki integration
CONFLUENCE_API_KEY=your-confluence-api-key-here
CONFLUENCE_BASE_URL=https://source.dallasmakerspace.org

# ----------------------------------------------------------------------------
# Door Controller Configuration
# ----------------------------------------------------------------------------

# HTTP socket timeout in seconds for door controller communication
# Default: 10 seconds
DOOR_CONTROLLER_TIMEOUT=10

# HTTP web interface credentials (same for all controllers)
DOOR_CONTROLLER_USERNAME=door-controller-username
DOOR_CONTROLLER_PASSWORD=your-password-here

# Door controllers are numbered sequentially (1-based indexing)
# Each controller requires: name, IP, serial, and comma-separated door list

# Controller 1: Building 102 Normal Doors
DOOR_CONTROLLER_1_IP=127.0.0.1
DOOR_CONTROLLER_1_SERIAL=1234
DOOR_CONTROLLER_1_DOORS=1,2,3,4

# Controller 2: Building 104 Normal Doors
DOOR_CONTROLLER_2_IP=127.0.0.1
DOOR_CONTROLLER_2_SERIAL=1234
DOOR_CONTROLLER_2_DOORS=1,2,3,4

# Controller 3: Building 102 Special
DOOR_CONTROLLER_3_IP=127.0.0.1
DOOR_CONTROLLER_3_SERIAL=1234
DOOR_CONTROLLER_3_DOORS=1,4

# Controller 4: Building 104 Special
DOOR_CONTROLLER_4_IP=127.0.0.1
DOOR_CONTROLLER_4_SERIAL=1234
DOOR_CONTROLLER_4_DOORS=4

# Note: Controller names are defined in application.conf and can be
# overridden with DOOR_CONTROLLER_N_NAME environment variables if needed

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log level (debug, info, warn, error)
ENV_LOG_LEVEL=info

# Elasticsearch logging (optional)
ENV_ELASTIC_HOST=localhost:9200
ENV_ELASTIC_API_KEY=your-elastic-api-key-here

# ----------------------------------------------------------------------------
# Kibana Discover Links (optional)
# ----------------------------------------------------------------------------
#
# When KIBANA_BASE_URL is set, interlock reports add a "Kibana" link to their
# metadata pointing at a pre-filtered Discover query (host + report-specific
# filter, scoped to the report's time window). Leave KIBANA_BASE_URL unset to
# suppress the link entirely.
#
# KIBANA_SPACE defaults to "default" if unset; KIBANA_DATA_VIEW defaults to
# "logs-*" if unset.

KIBANA_BASE_URL=https://kibana.example.com:5601
KIBANA_SPACE=members-read-only
KIBANA_DATA_VIEW=logs-*
