# Copy to .env (gitignored) and fill in. Use the real values only there.

# The portal service, as seen from the cast agent. On docker-h0 the service answers on the
# member-portal Docker network under this name.
SERVICE_URL=http://member-profile-service:8081

# The API client created for the agent (API_CLIENT_n_NAME / _KEY / _ROLE=CAST_AGENT on the service).
CAST_AGENT_CLIENT=cast-agent
CAST_AGENT_API_KEY=

# App ID of the Custom Receiver registered in the Google Cast SDK Developer Console, pointing at
# https://<portal host>/tv/receiver and published.
RECEIVER_APP_ID=

# Subnets (comma-separated CIDRs) to search for a TV whose address changed. Use the real ones in .env only.
SWEEP_RANGES=192.0.2.0/24
# How often (minutes) to sweep SWEEP_RANGES for every Cast device and report it to the TVs / Displays page; 0 turns it off.
DISCOVERY_INTERVAL_MINUTES=30

LOG_LEVEL=INFO
